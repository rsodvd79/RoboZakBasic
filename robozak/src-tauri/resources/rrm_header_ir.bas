' Do not modify or delete file without your skill
' Date : 2005. 12. 12
' Make : MINIROBOT Corp. Development Lab.
'

DIM A AS BYTE
DIM IR_ID_CODE AS BYTE

CONST IR_ID = 1

PTP SETON
PTP ALLON

DIR G6A,1,0,0,1,0,0
DIR G6B,1,1,1,1,1,1
DIR G6C,0,0,0,0,0,0
DIR G6D,0,1,1,0,1,0

GETMOTORSET G6A,1,1,1,1,1,0
GETMOTORSET G6B,1,1,1,0,0,0
GETMOTORSET G6C,1,1,1,0,0,0
GETMOTORSET G6D,1,1,1,1,1,0

SPEED 5

MOTOR G6A
MOTOR G6B
MOTOR G6C
MOTOR G6D

IF IR_ID = 1 THEN
	IR_ID_CODE = 0
ELSEIF IR_ID = 2 THEN
	IR_ID_CODE = 32
ELSEIF IR_ID = 3 THEN
	IR_ID_CODE = 64
ELSE 
	IR_ID_CODE = 96
ENDIF

A = 0

MAIN_LOOP:
A = REMOCON(1)
A = A - IR_ID_CODE
ON A GOTO MAIN_LOOP,K1,K2,K3,K4,K5,K6,K7,K8,K9,K10,K11,K12,K13,K14,K15,K16,K17,K18,K19,K20,K21,K22,K23,K24,K25,K26,K27,K28,K29,K30,K31,K32
GOTO MAIN_LOOP
END
